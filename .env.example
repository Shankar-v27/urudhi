# Copy to .env (gitignored). Values here are placeholders; never commit real ones.

# Razorpay TEST-mode credentials (Dashboard → Settings → API Keys, Test Mode).
# Urudhi refuses any key that does not start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret — the SAME value you enter in Dashboard → Webhooks.
# The API refuses to start without it. Events: payment_link.paid, payment.captured
# (+ virtual_account.credited if you use Smart Collect).
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Anthropic-compatible LLM endpoint for --brain claude (misconfiguration is fatal; no mock fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.llmsrelay.com
ANTHROPIC_MODEL=claude-sonnet-5

# Bearer token for /api/* and /inbound/* (≥ 8 chars).
URUDHI_API_TOKEN=change-me-urudhi-token
URUDHI_TZ=Asia/Kolkata

# Optional: public HTTPS base URL of your tunnel (display only, for scripts/live_demo.py)
# URUDHI_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# Optional email transport: sandbox (default, writes .eml files) or smtp
# URUDHI_EMAIL_MODE=sandbox
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_STARTTLS=1
