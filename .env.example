# Copy to .env (gitignored). Never commit real values.

# --- Brain: Anthropic-compatible endpoint (required for --brain claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com      # or your relay, e.g. https://api.llmsrelay.com
ANTHROPIC_MODEL=claude-sonnet-5

# --- Razorpay test mode (live demo only; the SDK client refuses non-test keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Required to serve the webhook receiver; the app refuses to start without it.
RAZORPAY_WEBHOOK_SECRET=

# --- API / dashboard ---
URUDHI_API_TOKEN=change-me-to-something-long     # bearer token for /api/* and /inbound/*
URUDHI_CORS_ORIGINS=http://localhost:5173
URUDHI_TZ=Asia/Kolkata                           # contact hours are judged in this zone

# --- Email transport: sandbox writes .eml files locally; smtp delivers ---
URUDHI_EMAIL_MODE=sandbox
URUDHI_OUTBOX_DIR=data/outbox
URUDHI_FROM_EMAIL=collections@urudhi.example.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
